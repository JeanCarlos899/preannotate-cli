# Copie para ~/.config/preannotate/.env (chmod 600) e preencha localmente.
# Alvo SSH: pode ser um alias do ~/.ssh/config (ex: gpu-server) ou usuario@host
PREANNOTATE_SSH_TARGET=gpu-server
PREANNOTATE_SSH_PORT=
PREANNOTATE_SSH_IDENTITY=

# Diretório base no servidor remoto e pasta de trabalho do usuário.
# O caminho remoto final será: <REMOTE_ROOT>/<WORKSPACE_USER>/<PROJETO>
PREANNOTATE_REMOTE_ROOT=/home/getter
PREANNOTATE_WORKSPACE_USER=meu_usuario
PREANNOTATE_WORKSPACE_DIR=preannotate

# Venv isolado por projeto por padrão. Vazio reutiliza os pesos compartilhados em:
# /home/getter/models/sam2.1/sam2.1_hiera_large.pt
# Preencha CHECKPOINT somente para usar pesos particulares ou outro servidor.
PREANNOTATE_REMOTE_VENV=
PREANNOTATE_SAM2_CHECKPOINT=
PREANNOTATE_SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_l.yaml
